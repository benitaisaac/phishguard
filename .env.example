# PhishGuard configuration (all optional)
#
# PhishGuard runs without any environment variables or secrets — the core and the
# web dashboard work fully offline. This file documents the *optional* knobs only.
# Copy to ".env" and adjust if you build on top of PhishGuard.

# Path to a custom labelled dataset (CSV with columns: url,label)
# PHISHGUARD_DATA=./data/urls.csv

# Probability threshold for the "phishing" decision (default 0.5)
# PHISHGUARD_THRESHOLD=0.5

# NOTE: never commit a real ".env" file — it is git-ignored.
